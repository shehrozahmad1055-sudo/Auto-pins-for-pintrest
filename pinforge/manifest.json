{
  "manifest_version": 3,
  "name": "PinForge \u2014 AI Pinterest Pin Writer",
  "short_name": "PinForge",
  "version": "1.4.1",
  "description": "Drop images, let Google Gemini write Pinterest titles, descriptions, keywords, alt text and boards, and publish the pins to your Pinterest account automatically.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PinForge",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "debugger",
    "downloads",
    "downloads.ui"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://*.pinterest.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
